{
  "name": "lectur-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de Lectur (Sprint 2): usuarios por rol, textos, asignaciones, cuestionarios, semáforo, notas y diccionario.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "seed:demo": "node src/seed.js --demo",
    "test": "node --test \"test/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.0",
    "rae-api": "^1.5.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "embedded-postgres": "^18.0.0-beta.1",
    "globals": "^16.0.0",
    "prettier": "^3.6.0"
  }
}
